# Backend API base URL proxied by the Cloudflare Pages Function
# (functions/api/backend/[[path]].ts) and the local Express server.
# Defaults to the PrimeHire v1 endpoint when unset.
BACKEND_URL=https://api.placement.vils.ai/primehire/api/v1

# Server-side PrimeHire credentials (never exposed to the browser).
# Required in the Pages environment for /api/backend/* to work.
# V2 Assessment Management reuses these existing form-publication settings in
# memory through scripts/run_v2_backend.py; no second credential set is required.
PRIMEHIRE_ACCESS_KEY=your_access_key
PRIMEHIRE_SECRET_KEY=your_secret_key

# Optional: extra frontend domains allowed to call /api/backend/* and
# /api/send-email cross-origin (comma-separated). Same-origin calls always
# work without this. Example:
# ALLOWED_ORIGINS=https://admin.example.com,https://app.example.com
ALLOWED_ORIGINS=

# Local FastAPI base URL proxied by the Express dev server (`npm run dev`).
# Every /api/* route that isn't handled locally (health, send-email,
# primehire/backend) is forwarded here, so the React app can call
# /api/assessments, /api/candidates, /api/users, ... same-origin.
FASTAPI_URL=http://127.0.0.1:8000
# E2E database settings DATABASE_BACKEND/POSTGRES_URL/POSTGRES_SCHEMA belong only
# in the backend environment, never frontend or VITE_* settings.

# The standalone frontend now uses same-origin /api/* for every client.
# VITE_API_URL is no longer a deployment setting. Use FASTAPI_URL for local
# Express/Vite proxying and the Pages runtime BACKEND_ORIGIN for production.

# Optional: Origin header sent on the server-to-server backend request.
# Only set this if the backend expects a specific origin (e.g. localhost).
# PROXY_ORIGIN=http://localhost:3000

# Server-side ZeptoMail key for POST /api/send-email (never exposed to the browser).
ZEPTOMAIL_API_KEY=your_zeptomail_key

# Auth signing key shared with FastAPI backend for JWT verification in Pages/Express proxy.
JWT_SECRET=your_jwt_secret_at_least_32_chars

# --- Phase 2 (backend mirrors; server-side only, never the browser) ---
# LLM provider + model used for resume parsing/scoring assistance (advisory only).
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=your_openrouter_key
# OPENROUTER_MODEL= (pick a currently-free OpenRouter model; empty = LLM disabled)
# LLM resilience Tier 1 mirrors (see backend/.env.example for the full list
# with defaults; dev-only fake provider is refused in production).
# LLM_RPM=30
# LLM_BURST=5
# LLM_WAIT_SECONDS=120
# LLM_FAKE_PROVIDER=off
# Upload caps + retention (mirror backend/.env.example).
# UPLOAD_MAX_MB=5
# UPLOAD_BATCH_MAX=10
# RETENTION_DAYS=365
# Jobs JD upload is local-only; OpenRouter settings apply to resume scoring.
# Organization timezone controls Jobs date inputs/display (fallback Asia/Kolkata).

# Isolated V2 local backend (scripts/run_v2_backend.py)
# FASTAPI_URL=http://127.0.0.1:8002


# Module 2 — enabled only by the isolated V2 launcher / explicit deployment.
RESUME_MODULE_V2_ENABLED=false
RESUME_IDENTITY_SECRET=
RESUME_CLAMD_HOST=127.0.0.1
RESUME_CLAMD_PORT=3310
RESUME_SCAN_TIMEOUT_S=30
RESUME_OCR_TESSDATA=
RESUME_DOC_CONVERTER=
RESUME_WORKER_CONCURRENCY=2
RESUME_UPLOAD_CONCURRENCY=32
RESUME_ATS_MODEL=
# V2 recruitment portals/calendar; enable only against the isolated V2 database.
RECRUITMENT_PORTALS_ENABLED=false
# Optional isolated Fernet key for recruitment; falls back to existing outbox key.
RECRUITMENT_OUTBOX_ENCRYPTION_KEY=
# Optional recruitment-only overrides; leave dry-run commented to inherit assessment settings.
RECRUITMENT_ZEPTOMAIL_API_KEY=
RECRUITMENT_EMAIL_TEST_RECIPIENT_ALLOWLIST=
# RECRUITMENT_EMAIL_DRY_RUN=false
# Module 4 Candidate Management is enabled only on primehire_admin_v2.
# Reuses JWT_SECRET for signed invite links and OUTBOX_ENCRYPTION_KEY (or the
# existing RECRUITMENT_OUTBOX_ENCRYPTION_KEY fallback) to encrypt
# provider URLs. Share links manually; no new email flag or service is required.

# Resume ATS range is saved per upload batch in V2 (0-100 inclusive).
# No new environment flag or service. Existing ATS provider/fallback settings apply.
# Scoring precedes human candidate confirmation; out-of-range resumes are retained.
# Deployment: Oracle backend uses backend/deploy/oracle/backend.env.example.
# Cloudflare uses frontend/ only; BACKEND_ORIGIN is a Pages runtime binding.
# Do not copy this legacy development/BFF environment into Cloudflare.
# This frontend/dev template must never contain production backend secrets.
# See docs/ORACLE_BACKEND_DEPLOYMENT.md before Cloudflare cutover.
# HR questions use the existing backend model configuration; no frontend AI key.

# Job candidate reports reuse existing assessment-provider settings; no new key.
# Assessment invitation search reuses existing scoped APIs; no configuration key.
# Apple-inspired UI appearance is client-side; no new provider or DB setting.
# Direct Google OAuth / Calendar (backend-only; never use a public frontend prefix).
# Keep disabled until a Web application OAuth client and consent screen are ready.
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
GOOGLE_LOGIN_ORG_ID=default
GOOGLE_TOKEN_ENCRYPTION_KEY=
# Application hard cap across this OAuth client, maximum 10000/day.
GOOGLE_CALENDAR_DAILY_LIMIT=10000

# Backend assessment result checks: at least one minute, bounded batch size.
ASSESSMENT_SYNC_INTERVAL_S=60
ASSESSMENT_SYNC_BATCH=20

# Calendar connection is optional for manual interview scheduling; no new setting.

# Full-width interview review pages and rating cards reuse existing APIs; no new setting.

# Review-submission thanks use a local static illustration; no runtime AI or new key.

# Separate source repositories require no new runtime variables; keep private values out of Git.
