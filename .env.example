# Backend API base URL proxied by the Cloudflare Pages Function
# (functions/api/backend/[[path]].ts) and the local Express server.
# Defaults to the PrimeHire v1 endpoint when unset.
BACKEND_URL=https://api.placement.vils.ai/primehire/api/v1

# Server-side PrimeHire credentials (never exposed to the browser).
# Required in the Pages environment for /api/backend/* to work.
PRIMEHIRE_ACCESS_KEY=your_access_key
PRIMEHIRE_SECRET_KEY=your_secret_key

# Optional: extra frontend domains allowed to call /api/backend/* and
# /api/send-email cross-origin (comma-separated). Same-origin calls always
# work without this. Example:
# ALLOWED_ORIGINS=https://admin.example.com,https://app.example.com
ALLOWED_ORIGINS=

# Optional: Origin header sent on the server-to-server backend request.
# Only set this if the backend expects a specific origin (e.g. localhost).
# PROXY_ORIGIN=http://localhost:3000

# Server-side ZeptoMail key for POST /api/send-email (never exposed to the browser).
ZEPTOMAIL_API_KEY=your_zeptomail_key
