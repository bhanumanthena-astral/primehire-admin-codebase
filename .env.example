# Backend API base URL proxied by the Cloudflare Pages Function
# (functions/api/backend/[[path]].ts) and the local Express server.
# Defaults to the PrimeHire v1 endpoint when unset.
BACKEND_URL=https://api.placement.vils.ai/primehire/api/v1

# Server-side PrimeHire credentials (never exposed to the browser).
# Required in the Pages environment for /api/backend/* to work.
PRIMEHIRE_ACCESS_KEY=your_access_key
PRIMEHIRE_SECRET_KEY=your_secret_key

# Optional: extra frontend domains allowed to call /api/backend/* and
# /api/send-email cross-origin (comma-separated). Same-origin calls always
# work without this. Example:
# ALLOWED_ORIGINS=https://admin.example.com,https://app.example.com
ALLOWED_ORIGINS=

# Local FastAPI base URL proxied by the Express dev server (`npm run dev`).
# Every /api/* route that isn't handled locally (health, send-email,
# primehire/backend) is forwarded here, so the React app can call
# /api/assessments, /api/candidates, /api/users, ... same-origin.
FASTAPI_URL=http://127.0.0.1:8000

# Frontend → FastAPI base URL for the MongoDB read cutover (Vite env).
# The React app reads this as VITE_API_URL at build time.
# VITE_API_URL=http://localhost:8000

# Optional: Origin header sent on the server-to-server backend request.
# Only set this if the backend expects a specific origin (e.g. localhost).
# PROXY_ORIGIN=http://localhost:3000

# Server-side ZeptoMail key for POST /api/send-email (never exposed to the browser).
ZEPTOMAIL_API_KEY=your_zeptomail_key

# Auth signing key shared with FastAPI backend for JWT verification in Pages/Express proxy.
JWT_SECRET=your_jwt_secret_at_least_32_chars

# --- Phase 2 (backend mirrors; server-side only, never the browser) ---
# LLM provider + model used for resume parsing/scoring assistance (advisory only).
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=your_openrouter_key
# OPENROUTER_MODEL= (pick a currently-free OpenRouter model; empty = LLM disabled)
# LLM resilience Tier 1 mirrors (see backend/.env.example for the full list
# with defaults; dev-only fake provider is refused in production).
# LLM_RPM=30
# LLM_BURST=5
# LLM_WAIT_SECONDS=120
# LLM_FAKE_PROVIDER=off
# Upload caps + retention (mirror backend/.env.example).
# UPLOAD_MAX_MB=5
# UPLOAD_BATCH_MAX=10
# RETENTION_DAYS=365
