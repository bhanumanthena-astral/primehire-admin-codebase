  "components": {
    "schemas": {
      "AddJobRequest": {
        "properties": {
          "job_id": {
            "type": "string",
            "title": "Job Id"
          },
          "job_title": {
            "type": "string",
            "title": "Job Title"
          },
          "job_description": {
            "type": "string",
            "title": "Job Description"
          },
          "language": {
            "$ref": "#/components/schemas/Language"
          },
          "round_type": {
            "$ref": "#/components/schemas/RoundType"
          },
          "questions": {
            "items": {
              "type": "object"
            },
            "type": "array",
            "title": "Questions"
          }
        },
        "type": "object",
        "required": [
          "job_id",
          "job_title",
          "job_description",
          "language",
          "round_type",
          "questions"
        ],
        "title": "AddJobRequest"
      },
      "AddPartnerRequest": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "title": "AddPartnerRequest"
      },
      "AddPartnerResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "data": {
            "$ref": "#/components/schemas/schemas__partner__add_partner__Data"
          }
        },
        "type": "object",
        "required": [
          "status",
          "data"
        ],
        "title": "AddPartnerResponse"
      },
      "AllResponses": {
        "properties": {
          "count": {
            "type": "integer",
            "title": "Count"
          },
          "responses": {
            "items": {
              "$ref": "#/components/schemas/EachResponse"
            },
            "type": "array",
            "title": "Responses"
          }
        },
        "type": "object",
        "required": [
          "count",
          "responses"
        ],
        "title": "AllResponses"
      },
      "Candidate": {
        "properties": {
          "candidate_id": {
            "type": "string",
            "title": "Candidate Id"
          },
          "start_time": {
            "type": "string",
            "format": "date-time",
            "title": "Start Time",
            "default": "2026-06-26T16:44:16.850648"
          },
          "end_time": {
            "type": "string",
            "format": "date-time",
            "title": "End Time",
            "default": "2026-07-10T16:44:16.850656"
          }
        },
        "type": "object",
        "required": [
          "candidate_id"
        ],
        "title": "Candidate"
      },
      "CandidateLoginRequest": {
        "properties": {
          "username": {
            "type": "string",
            "title": "Username"
          },
          "password": {
            "type": "string",
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "CandidateLoginRequest"
      },
      "CandidateLoginResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "CandidateLoginResponse"
      },
      "Credentials": {
        "properties": {
          "access_key": {
            "type": "string",
            "title": "Access Key"
          },
          "secret_key": {
            "type": "string",
            "title": "Secret Key"
          }
        },
        "type": "object",
        "required": [
          "access_key",
          "secret_key"
        ],
        "title": "Credentials"
      },
      "CreditSystem": {
        "properties": {
          "total_credits": {
            "type": "integer",
            "title": "Total Credits",
            "default": 0
          }
        },
        "type": "object",
        "title": "CreditSystem"
      },
      "EachPartner": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          },
