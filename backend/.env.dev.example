# Isolated live-testing environment (dev database). Variable names only.
# Usage (from backend/, PowerShell):
#   Copy-Item .env .env.dev   # then set MONGODB_DATABASE=primehire_dev below
#   $env:BACKEND_ENV_FILE=".env.dev"
#   .\.venv\Scripts\python -m uvicorn app.main:app --port 8000
# NEVER point live testing at primehire_admin. NEVER commit real values.
MONGODB_URI=
MONGODB_DATABASE=primehire_dev

PRIMEHIRE_BASE_URL=https://api.placement.vils.ai/primehire/api/v1
PRIMEHIRE_ACCESS_KEY=
PRIMEHIRE_SECRET_KEY=

ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
PROXY_ORIGIN=

MIGRATION_SECRET=
