# Variable names only — never commit real values.
# Local dev: copy to backend/.env (git-ignored) and fill in.
# App environment: local | development | test | staging | production
ENV=local
# Never enable debug in production (startup fails if DEBUG=true with ENV=production).
DEBUG=false
MONGODB_URI=
MONGODB_DATABASE=primehire

PRIMEHIRE_BASE_URL=https://api.placement.vils.ai/primehire/api/v1
PRIMEHIRE_ACCESS_KEY=
PRIMEHIRE_SECRET_KEY=

# Auth signing key. REQUIRED in production (>=32 chars, not a placeholder).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Writable dir for uploads/resume storage (checked by GET /api/ready).
# Relative = under backend/. Absolute paths (e.g. /data/storage on the host) used as-is.
STORAGE_DIR=

# Optional Sentry-compatible DSN for error tracking (empty = disabled).
SENTRY_DSN=

# Optional: comma-separated extra origins for browser CORS (same-origin always works).
# Must be explicit in production; '*' fails startup when ENV=production.
ALLOWED_ORIGINS=
# Optional: Origin header sent on server-to-server PrimeHire requests.
PROXY_ORIGIN=

# Server-side secret for POST /api/migration/import (Phase 2 one-time import).
# Empty = endpoint disabled. Never put this in React, never log it.
MIGRATION_SECRET=

# --- Phase 2: resume pipeline / LLM / outbox / uploads ---
# LLM provider adapter ("openrouter", swappable later) + free-tier model.
# Pick a model currently listed as free on OpenRouter; never commit the key.
# Empty model = LLM disabled (deterministic scores + "LLM unavailable" flag).
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Max concurrent LLM calls (free-tier rate-limit guard).
LLM_CONCURRENCY=2

# Fernet key (urlsafe base64, 32 bytes) encrypting email_outbox bodies. REQUIRED in production.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
OUTBOX_ENCRYPTION_KEY=

# Backend ZeptoMail sender (server-side only). REQUIRED in production.
ZEPTOMAIL_API_KEY=
EMAIL_FROM_ADDRESS=noreply@nxtagent.ai
EMAIL_FROM_NAME=PrimeHire Careers

# Slice C safety: dry-run records emails without sending (default true).
# Production refuses dry-run. With dry-run off outside production, the
# allowlist below must name test recipients (emails or @domains).
EMAIL_DRY_RUN=true
EMAIL_TEST_RECIPIENT_ALLOWLIST=

# Completion-sync sweep: batch size and interval (seconds) for the worker.
ASSESSMENT_SYNC_BATCH=20
ASSESSMENT_SYNC_INTERVAL_S=300

# Upload caps: max MB per file, max files per batch, DOCX unzip cap (zip-bomb guard).
UPLOAD_MAX_MB=5
UPLOAD_BATCH_MAX=10
UPLOAD_MAX_UNCOMPRESSED_MB=20

# ClamAV hook: interface + quarantined status ship now; real clamd scan in Phase 7.
CLAMAV_ENABLED=false

# DPDP retention window (days). retentionUntil = upload time + this.
RETENTION_DAYS=365
