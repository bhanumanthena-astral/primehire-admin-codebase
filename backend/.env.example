# Variable names only — never commit real values.
# Local dev: copy to backend/.env (git-ignored) and fill in.
# App environment: local | development | test | staging | production
ENV=local
# Never enable debug in production (startup fails if DEBUG=true with ENV=production).
DEBUG=false
MONGODB_URI=
MONGODB_DATABASE=primehire_admin_v2
# E2E PostgreSQL is opt-in for isolated V2; existing V1/local defaults stay MongoDB.
DATABASE_BACKEND=mongodb
POSTGRES_URL=
POSTGRES_SCHEMA=elitehr
# For the isolated E2E test copy, use scripts/configure_e2e_local.py with the
# ignored test credential file, then npm run dev:local. Never use production
# database credentials for localhost development or expose PostgreSQL publicly.
# V2 local setup uses primehire_admin_v2 and scripts/run_v2_backend.py.
# Keep the V1 database separate; do not point V2 at a V1 database.

PRIMEHIRE_BASE_URL=https://api.placement.vils.ai/primehire/api/v1
# Existing PrimeHire settings also support Assessment Management publication.
# The local V2 launcher reuses the current form server's root .env settings;
# direct API deployments should configure these existing backend variables.
PRIMEHIRE_ACCESS_KEY=
PRIMEHIRE_SECRET_KEY=

# Auth signing key. REQUIRED in production (>=32 chars, not a placeholder).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Writable dir for uploads/resume storage (checked by GET /api/ready).
# Relative = under backend/. Absolute paths (e.g. /data/storage on the host) used as-is.
STORAGE_DIR=

# Optional Sentry-compatible DSN for error tracking (empty = disabled).
SENTRY_DSN=

# Optional: comma-separated extra origins for browser CORS (same-origin always works).
# Must be explicit in production; '*' fails startup when ENV=production.
ALLOWED_ORIGINS=
# Optional: Origin header sent on server-to-server PrimeHire requests.
PROXY_ORIGIN=

# Server-side secret for POST /api/migration/import (Phase 2 one-time import).
# Empty = endpoint disabled. Never put this in React, never log it.
MIGRATION_SECRET=

# --- Phase 2: resume pipeline / LLM / outbox / uploads ---
# LLM provider adapter ("openrouter", swappable later) + free-tier model.
# Pick a model currently listed as free on OpenRouter; never commit the key.
# Empty model = LLM disabled (deterministic scores + "LLM unavailable" flag).
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Max concurrent LLM calls (free-tier rate-limit guard).
LLM_CONCURRENCY=2

# --- LLM resilience Tier 1 (all have safe defaults; unset = defaults apply) ---
# Background LLM retries: attempts cap + total age cap (hours) before the
# deterministic fallback wins with a visible flag.
LLM_JOB_MAX_ATTEMPTS=12
LLM_JOB_MAX_AGE_HOURS=6
# Stage decisions wait this long (seconds) for a deferred LLM, then decide
# on the deterministic score; a late LLM only annotates / needsReview.
LLM_WAIT_SECONDS=120
# Shared token bucket per provider+model: requests/minute, burst size, and
# the share of burst reserved for interactive (sync) calls.
LLM_RPM=30
LLM_BURST=5
LLM_INTERACTIVE_RESERVE=0.25
# Circuit breaker: consecutive 429/5xx to open, cooldown seconds to half-open.
LLM_BREAKER_THRESHOLD=5
LLM_BREAKER_COOLDOWN_S=300
# Borderline band around the job threshold: without a usable LLM score,
# candidates inside +/-margin go to needsReview instead of auto-pool.
LLM_BORDERLINE_MARGIN=10
# Dev-only fake provider for 429 drills: off | mixed | down. REFUSED when
# ENV=production (startup failure). Failure rate 0..1 for mixed mode.
LLM_FAKE_PROVIDER=off
LLM_FAKE_FAILURE_RATE=0.5
LLM_FAKE_RETRY_AFTER_S=5

# Fernet key (urlsafe base64, 32 bytes) encrypting email_outbox bodies. REQUIRED in production.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
OUTBOX_ENCRYPTION_KEY=

# Backend ZeptoMail sender (server-side only). REQUIRED in production.
ZEPTOMAIL_API_KEY=
EMAIL_FROM_ADDRESS=noreply@nxtagent.ai
EMAIL_FROM_NAME=PrimeHire Careers

# Slice C safety: dry-run records emails without sending (default true).
# Production refuses dry-run. With dry-run off outside production, the
# allowlist below must name test recipients (emails or @domains).
EMAIL_DRY_RUN=true
EMAIL_TEST_RECIPIENT_ALLOWLIST=

# Completion-sync sweep: batch size and interval (seconds) for the worker.
ASSESSMENT_SYNC_BATCH=20
ASSESSMENT_SYNC_INTERVAL_S=60

# Automatic job-closure sweep interval (seconds) in the background worker.
JOBS_AUTO_CLOSE_INTERVAL_S=60

# Upload caps: max MB per file, max files per batch, DOCX unzip cap (zip-bomb guard).
UPLOAD_MAX_MB=5
UPLOAD_BATCH_MAX=10
UPLOAD_MAX_UNCOMPRESSED_MB=20

# ClamAV hook: interface + quarantined status ship now; real clamd scan in Phase 7.
CLAMAV_ENABLED=false

# DPDP retention window (days). retentionUntil = upload time + this.
RETENTION_DAYS=365
# Jobs JD upload is local-only; OpenRouter settings apply to resume scoring.
# Organization timezone controls Jobs date inputs/display (fallback Asia/Kolkata).


# Module 2 — enabled only by the isolated V2 launcher / explicit deployment.
RESUME_MODULE_V2_ENABLED=false
RESUME_IDENTITY_SECRET=
RESUME_CLAMD_HOST=127.0.0.1
RESUME_CLAMD_PORT=3310
RESUME_SCAN_TIMEOUT_S=30
RESUME_OCR_TESSDATA=
RESUME_DOC_CONVERTER=
RESUME_WORKER_CONCURRENCY=2
RESUME_UPLOAD_CONCURRENCY=32
RESUME_ATS_MODEL=
# V2 recruitment portals/calendar; enable only against the isolated V2 database.
RECRUITMENT_PORTALS_ENABLED=false
# Optional isolated Fernet key for recruitment; falls back to existing outbox key.
RECRUITMENT_OUTBOX_ENCRYPTION_KEY=
# Optional recruitment-only overrides; leave dry-run commented to inherit assessment settings.
RECRUITMENT_ZEPTOMAIL_API_KEY=
RECRUITMENT_EMAIL_TEST_RECIPIENT_ALLOWLIST=
# RECRUITMENT_EMAIL_DRY_RUN=false
# Module 4 Candidate Management is enabled only on primehire_admin_v2.
# Reuses JWT_SECRET for signed invite links and OUTBOX_ENCRYPTION_KEY (or the
# existing RECRUITMENT_OUTBOX_ENCRYPTION_KEY fallback) to encrypt
# provider URLs. Share links manually; no new email flag or service is required.

# Resume ATS range is saved per upload batch in V2 (0-100 inclusive).
# No new environment flag or service. Existing ATS provider/fallback settings apply.
# Scoring precedes human candidate confirmation; out-of-range resumes are retained.
# Oracle production template: deploy/oracle/backend.env.example.
# The separate Cloudflare frontend proxies same-origin /api/* to BACKEND_ORIGIN.
# Add its exact Pages origin to ALLOWED_ORIGINS before enabling browser login.
# Production requires isolated local primehire_admin_v2 and private persistent
# storage. See ../docs/ORACLE_BACKEND_DEPLOYMENT.md; do not copy V1 data/secrets.

# Meta WhatsApp Cloud API (optional; disabled until manager approval per job).
# Template body has two positional text parameters: job title, HTTPS assessment link.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en_US
WHATSAPP_PRICE_PER_MESSAGE=0
WHATSAPP_CURRENCY=INR
# HR-only JD/resume questions share existing OpenRouter settings and limits.
# No provider key: explicitly labelled local HR guidance; ATS settings unchanged.

# Job candidate reports reuse existing assessment-provider settings; no new key.
# Assessment invitation search reuses existing scoped APIs; no configuration key.

# Comma-separated approved video origins for the authorized Reports media proxy.
REPORT_MEDIA_ALLOWED_HOSTS=
# Apple-inspired UI appearance is client-side; no new provider or DB setting.
# Direct Google OAuth / Calendar (server-only; existing staff accounts only).
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
GOOGLE_LOGIN_ORG_ID=default
GOOGLE_TOKEN_ENCRYPTION_KEY=
GOOGLE_CALENDAR_DAILY_LIMIT=10000

# Calendar connection is optional for manual interview scheduling; no new setting.

# Full-width interview review pages and rating cards reuse existing APIs; no new setting.

# Review-submission thanks use a local static illustration; no runtime AI or new key.

# Separate source repositories require no new runtime variables; keep private values out of Git.
