# Variable names only — never commit real values.
# Local dev: copy to backend/.env (git-ignored) and fill in.
MONGODB_URI=
MONGODB_DATABASE=primehire

PRIMEHIRE_BASE_URL=https://api.placement.vils.ai/primehire/api/v1
PRIMEHIRE_ACCESS_KEY=
PRIMEHIRE_SECRET_KEY=

# Optional: comma-separated extra origins for browser CORS (same-origin always works).
ALLOWED_ORIGINS=
# Optional: Origin header sent on server-to-server PrimeHire requests.
PROXY_ORIGIN=

# Server-side secret for POST /api/migration/import (Phase 2 one-time import).
# Empty = endpoint disabled. Never put this in React, never log it.
MIGRATION_SECRET=
