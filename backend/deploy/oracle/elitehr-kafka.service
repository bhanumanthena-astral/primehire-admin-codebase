[Unit]
Description=Private single-node Kafka for resume dispatch
Requires=docker.service
After=docker.service network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Slice=elitehr.slice
ExecStart=/usr/bin/docker run --rm --name elitehr-kafka --network host --cgroup-parent=elitehr.slice --memory=1g --memory-swap=1g --cpus=0.35 --pids-limit=160 --log-opt max-size=5m --log-opt max-file=3 --env-file /etc/elitehr/kafka.env --mount type=bind,source=/var/lib/elitehr/kafka,target=/var/lib/kafka/data apache/kafka:4.3.2
ExecStop=/usr/bin/docker stop --time 45 elitehr-kafka
Restart=on-failure
RestartSec=10
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
