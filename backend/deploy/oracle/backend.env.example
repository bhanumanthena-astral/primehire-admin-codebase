# Private runtime file: /etc/elitehr/backend.env, root:elitehr 0640.
# Never commit a filled copy, place secrets in Cloudflare, or print this file.
ENV=production
DEBUG=false
APP_NAME=elitehr-v2
MONGODB_DATABASE=primehire_admin_v2
# Provisioning replaces this with the local authenticated MongoDB URI.
MONGODB_URI=__PROVISIONED_LOCALLY__
STORAGE_DIR=/var/lib/elitehr/storage
RESUME_MODULE_V2_ENABLED=true
RECRUITMENT_PORTALS_ENABLED=true
# Initial backend-only setup permits no public frontend. Replace at frontend cutover.
ALLOWED_ORIGINS=https://localhost
JWT_SECRET=__TRANSFER_SECURELY__
RESUME_IDENTITY_SECRET=__TRANSFER_SECURELY__
# Preserve existing encryption keys exactly when migrating V2 data.
OUTBOX_ENCRYPTION_KEY=__TRANSFER_SECURELY__
RECRUITMENT_OUTBOX_ENCRYPTION_KEY=
ZEPTOMAIL_API_KEY=__TRANSFER_SECURELY__
EMAIL_FROM_ADDRESS=noreply@nxtagent.ai
EMAIL_FROM_NAME=Elite HR
EMAIL_DRY_RUN=false
# Email delivery services are installed but NOT enabled by bootstrap.
RECRUITMENT_EMAIL_DRY_RUN=true
RESUME_CLAMD_HOST=127.0.0.1
RESUME_CLAMD_PORT=3310
RESUME_SCAN_TIMEOUT_S=30
RESUME_WORKER_CONCURRENCY=1
RESUME_UPLOAD_CONCURRENCY=4
RESUME_OCR_TESSDATA=/usr/share/tesseract-ocr/5/tessdata
RESUME_DOC_CONVERTER=/usr/bin/antiword
CLAMAV_ENABLED=true
LLM_FAKE_PROVIDER=off
LLM_CONCURRENCY=1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
RESUME_ATS_MODEL=
PRIMEHIRE_BASE_URL=https://api.placement.vils.ai/primehire/api/v1
PRIMEHIRE_ACCESS_KEY=
PRIMEHIRE_SECRET_KEY=
MIGRATION_SECRET=

# Enable only after installing the dedicated 8 GB free profile and private Kafka.
FREE_TIER_GUARD_ENABLED=false
FREE_TIER_ACTIVE_RESUME_LIMIT=1000
RESUME_KAFKA_ENABLED=false
RESUME_KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092

# Direct Google OAuth / Calendar: enable only after registering the public frontend callback.
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://YOUR-APP-DOMAIN/api/auth/google/callback
GOOGLE_LOGIN_ORG_ID=default
GOOGLE_TOKEN_ENCRYPTION_KEY=
GOOGLE_CALENDAR_DAILY_LIMIT=10000
