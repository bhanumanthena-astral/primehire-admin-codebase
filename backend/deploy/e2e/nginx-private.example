# Private browser verification only; expose HTTPS after DNS/certificate setup.
server {
    listen 127.0.0.1:9000;
    server_name localhost;
    root /srv/elitehr/frontend;
    index index.html;
    client_max_body_size 130m;
    server_tokens off;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header X-Frame-Options DENY always;
    add_header Content-Security-Policy "frame-ancestors 'none'; base-uri 'self'; object-src 'none'" always;
    location ~ ^/(docs|redoc|openapi.json|api/migration)(/|$) { return 404; }
    location ~ /\. { return 404; }
    location /api/ {
        proxy_pass http://127.0.0.1:8002;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
        proxy_connect_timeout 5s;
        proxy_buffering off;
    }
    location ~ ^/(_worker\.js|_headers|_routes\.json)$ { return 404; }
    location /assets/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
    location / {
        add_header Cache-Control no-store;
        try_files $uri $uri/ /index.html;
    }
}
